<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RattoLauncher.App.ViewModels.Pages"
             x:Class="RattoLauncher.App.Views.Pages.BuildView"
             x:DataType="vm:BuildViewModel">
    <ScrollViewer>
        <StackPanel Spacing="12">
            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold"/>

            <Border Classes="card">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <Button Content="Reload settings" Command="{Binding ReloadCommand}"/>

                    <!-- built -->
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding IsBuilt}">
                        <PathIcon Width="16" Height="16" Foreground="{DynamicResource Success}" Data="M3,12 L5,10 L9,14 L19,4 L21,6 L9,18 Z"/>
                        <TextBlock Text="Game is built" FontSize="12" Foreground="{DynamicResource Success}"/>
                    </StackPanel>

                    <!-- not built -->
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding !IsBuilt}">
                        <PathIcon Width="16" Height="16" Foreground="{DynamicResource Warning}" Data="M10.5,4 H13.5 V14 H10.5 Z M10.5,17 H13.5 V20 H10.5 Z"/>
                        <TextBlock Text="Not built yet" FontSize="12" Foreground="{DynamicResource Warning}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StepViewModel">
                        <Border Classes="card" Margin="0,0,0,8">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{DynamicResource TextMuted}"/>
                                </Grid>
                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}"/>
                                <TextBlock Text="{Binding Detail}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Content="START" Command="{Binding RunAllCommand}" HorizontalAlignment="Left" Padding="28,10"/>
                <Button Content="Cancel" Command="{Binding RunAllCancelCommand}"/>
            </StackPanel>

            <Border Classes="card">
                <ScrollViewer Height="140">
                    <ItemsControl ItemsSource="{Binding Log}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>