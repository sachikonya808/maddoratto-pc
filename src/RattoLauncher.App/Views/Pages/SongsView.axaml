<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RattoLauncher.App.ViewModels.Pages"
        x:Class="RattoLauncher.App.Views.Pages.SongsView"
        x:DataType="vm:SongsViewModel">
    
    <Grid ColumnDefinitions="7*, 13*" ColumnSpacing="16">
        <StackPanel Spacing="12" Grid.Column="0">
            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold"/>

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" RowDefinitions="Auto, Auto" RowSpacing="8">
                        <TextBlock Grid.Row="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding PackedModsFolder, TargetNullValue='PNG folder: not selected'}"/>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="Browse Songs" Command="{Binding OpenModsFolderCommand}" HorizontalAlignment="Left"/>
                            <Button Content="Browse LayeredFS" Command="{Binding OpenLayeredFSFolderCommand}"/>
                            <Button Content="Unlock Save" Command="{Binding UnlockSaveCommand}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="primary" Content="ADD SONGS" Command="{Binding BuildCommand}" HorizontalAlignment="Left" Padding="24,10"/>
                        <Button Content="Cancel" Command="{Binding BuildCancelCommand}"/>
                    </StackPanel>

                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}"/>       
                    <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding Details, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <SelectableTextBlock Text="{Binding Details}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <Grid Grid.Column="1" ColumnDefinitions="4*, 6*" ColumnSpacing="12">
            <Border Grid.Column="0" Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding SelectedPackage.Title}" FontSize="18"/>
                    <TextBlock Text="{Binding SelectedPackage.Composer}" Foreground="{DynamicResource TextMuted}"/>


                    <Border CornerRadius="8" ClipToBounds="True">
                        <Image Source="{Binding SelectedPackage.Image}" Stretch="Uniform" MaxHeight="250"/>
                    </Border>

                    <TextBlock Text="" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SelectedPackage.BPM}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SelectedPackage.BaseID}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Classes="card">
                <Grid RowDefinitions="Auto, *" RowSpacing="10">
                    <TextBlock Text="Available Files" FontSize="18"/>
                    
                    <ListBox Grid.Row="1" ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}"/>
                                    <TextBlock Text="{Binding ZipPath}" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>