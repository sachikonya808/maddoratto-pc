<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RattoLauncher.App.ViewModels.Pages"
        x:Class="RattoLauncher.App.Views.Pages.PlayView"
        x:DataType="vm:PlayViewModel">
    
    <StackPanel Spacing="12">
        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold"/>
        <TextBlock Text="Welcome back!" Foreground="{DynamicResource TextMuted}"/>
        
        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="{Binding HeadlineText}" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                <Button Classes="primary" Content="{Binding ButtonText}" Command="{Binding PrimaryActionCommand}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>