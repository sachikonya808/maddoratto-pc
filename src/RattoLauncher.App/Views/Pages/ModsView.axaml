<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RattoLauncher.App.ViewModels.Pages"
        x:Class="RattoLauncher.App.Views.Pages.ModsView"
        x:DataType="vm:ModsViewModel">
    
    <StackPanel Spacing="12">
    <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold"/>

    <Border Classes="card">
        <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                    Text="{Binding PngFolder, TargetNullValue='PNG folder: not selected'}"/>
            <Button Grid.Column="1" Content="Browse" Click=""/>
        </Grid>
        <TextBox Watermark="Mod name" Text="{Binding ModName}"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Prepare" Command="{Binding InitializeCommand}"/>
            <Button Classes="primary" Content="BUILD MOD" Command="{Binding BuildCommand}"
                    HorizontalAlignment="Left" Padding="24,10"/>
            <Button Content="Cancel" Command="{Binding BuildCancelCommand}"/>
        </StackPanel>
        <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}"
                    IsIndeterminate="{Binding IsIndeterminate}"/>
        <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
        </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding Details, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding Details}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
    </Border>
    </StackPanel>
</UserControl>